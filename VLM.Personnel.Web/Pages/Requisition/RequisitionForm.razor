@page "/requisitions/new"
@page "/requisitions/{Id:long}/edit"
@using Radzen
@using Radzen.Blazor
@inject RequisitionService RequisitionSvc
@inject LookupService LookupSvc
@inject NavigationManager Nav
@inject NotificationService NotificationSvc

<PageTitle>@(_isEdit ? "Edit Requisition" : "New Requisition")</PageTitle>

<div class="vlm-page-header">
    <div>
        <h3>@(_isEdit ? "Edit Requisition" : "New Requisition")</h3>
        <p>@(_isEdit ? $"Editing Requisition #{Id}" : "Fill in the details below")</p>
    </div>
    <RadzenButton Text="Back to List"
                  Icon="arrow_back"
                  ButtonStyle="ButtonStyle.Light"
                  Click="@(() => Nav.NavigateTo("/requisitions"))" />
</div>

@if (_loading)
{
    <div style="display:flex;justify-content:center;padding:60px;">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </div>
}
else
{
    <EditForm Model="_form" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="vlm-card" style="margin-bottom:20px;">
            <div class="vlm-card-body">
                <div class="vlm-section-label">Requisition Info</div>
                <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;">

                    <div>
                        <RadzenLabel Text="Date *" />
                        <RadzenDatePicker @bind-Value="_form.ReqDate"
                                          DateFormat="dd/MM/yyyy"
                                          Style="width:100%;" />
                    </div>

                    <div>
                        <RadzenLabel Text="Division *" />
                        <RadzenDropDown Data="@_divisions"
                                        TextProperty="DivisionName"
                                        ValueProperty="DivisionId"
                                        @bind-Value="_form.DivisionId"
                                        Change="@(args => OnDivisionChanged(args))"
                                        Placeholder="Select Division"
                                        Style="width:100%;" />
                    </div>

                    <div>
                        <RadzenLabel Text="Department *" />
                        <RadzenDropDown Data="@_departments"
                                        TextProperty="DepartmentName"
                                        ValueProperty="DepartmentId"
                                        @bind-Value="_form.DepartmentId"
                                        Placeholder="Select Department"
                                        Disabled="@(_form.DivisionId <= 0)"
                                        Style="width:100%;" />
                    </div>

                    <div>
                        <RadzenLabel Text="Designation *" />
                        <RadzenDropDown Data="@_designations"
                                        TextProperty="DesignationName"
                                        ValueProperty="DesignationId"
                                        @bind-Value="_form.DesignationId"
                                        Placeholder="Select Designation"
                                        Style="width:100%;" />
                    </div>

                    <div>
                        <RadzenLabel Text="Vacancy *" />
                        <RadzenNumeric @bind-Value="_form.Vacancy"
                                       Min="1"
                                       Style="width:100%;" />
                    </div>

                    @if (_isEdit)
                    {
                        <div>
                            <RadzenLabel Text="Status" />
                            <RadzenDropDown Data="@_statuses"
                                            @bind-Value="_form.Status"
                                            Style="width:100%;" />
                        </div>
                    }

                    <div style="grid-column:1/-1;">
                        <RadzenLabel Text="Description" />
                        <RadzenTextArea @bind-Value="_form.Description"
                                        Rows="3"
                                        Style="width:100%;" />
                    </div>
                </div>
            </div>
        </div>

        <div class="vlm-card" style="margin-bottom:20px;">
            <div class="vlm-card-body">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div class="vlm-section-label" style="margin:0;border:none;">KPI Details</div>
                    <RadzenButton Text="Add Row"
                                  Icon="add"
                                  ButtonStyle="ButtonStyle.Secondary"
                                  Size="ButtonSize.Small"
                                  Click="AddDetailRow" />
                </div>

                <RadzenDataGrid @ref="_grid"
                                Data="@_form.Details"
                                TItem="RequisitionDetailUpdateDto"
                                Style="margin-top:12px;border:none;"
                                EmptyText="No KPI rows. Click Add Row.">
                    <Columns>
                        <RadzenDataGridColumn TItem="RequisitionDetailUpdateDto" Title="PERSPECTIVE" Width="180px">
                            <Template Context="row">
                                <RadzenDropDown Data="@_perspectives"
                                                TextProperty="PerspectiveName"
                                                ValueProperty="PerspectiveId"
                                                @bind-Value="row.PerspectiveId"
                                                Style="width:100%;" />
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="RequisitionDetailUpdateDto" Title="OBJECTIVE">
                            <Template Context="row">
                                <RadzenTextBox @bind-Value="row.Objective" Style="width:100%;" />
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="RequisitionDetailUpdateDto" Title="KPI" Width="160px">
                            <Template Context="row">
                                <RadzenTextBox @bind-Value="row.KPI" Style="width:100%;" />
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="RequisitionDetailUpdateDto" Title="WEIGHT %" Width="110px">
                            <Template Context="row">
                                <RadzenNumeric @bind-Value="row.WeightagePercentage"
                                               Min="0" Max="100"
                                               Style="width:100%;" />
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="RequisitionDetailUpdateDto" Title="REMARKS" Width="160px">
                            <Template Context="row">
                                <RadzenTextBox @bind-Value="row.Remarks" Style="width:100%;" />
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="RequisitionDetailUpdateDto" Title="" Width="60px" TextAlign="TextAlign.Center">
                            <Template Context="row">
                                <RadzenButton Icon="delete"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Size="ButtonSize.Small"
                                              Click="@(() => RemoveDetailRow(row))" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>

                <div style="text-align:right;margin-top:10px;font-size:0.82rem;color:#718096;">
                    Total Weight:
                    <strong style="color:@(_totalWeight == 100 ? "#48bb78" : "#e53e3e")">
                        @_totalWeight %
                    </strong>
                </div>
            </div>
        </div>

        <div style="display:flex;gap:12px;justify-content:flex-end;">
            <RadzenButton Text="Cancel"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@(() => Nav.NavigateTo("/requisitions"))" />
            <RadzenButton Text="@(_isEdit ? "Update" : "Save")"
                          Icon="save"
                          ButtonStyle="ButtonStyle.Primary"
                          ButtonType="ButtonType.Submit"
                          IsBusy="@_saving" />
        </div>
    </EditForm>
}

@code {
    [Parameter] public long? Id { get; set; }

    private RadzenDataGrid<RequisitionDetailUpdateDto> _grid;
    private bool _isEdit => Id.HasValue;
    private bool _loading = true;
    private bool _saving = false;

    private RequisitionUpdateDto _form = new()
    {
        ReqDate = DateTime.Today,
        Details = new List<RequisitionDetailUpdateDto>()
    };

    private List<DivisionDto> _divisions = new();
    private List<DepartmentDto> _departments = new();
    private List<DesignationDto> _designations = new();
    private List<PerspectiveDto> _perspectives = new();
    private List<string> _statuses = new() { "Draft", "Pending", "Approved", "Rejected", "Cancelled" };

    private decimal _totalWeight => _form.Details?.Sum(d => d.WeightagePercentage ?? 0) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var t1 = LookupSvc.GetDivisionsAsync();
            var t2 = LookupSvc.GetDesignationsAsync();
            var t3 = LookupSvc.GetPerspectivesAsync();
            await Task.WhenAll(t1, t2, t3);

            _divisions = t1.Result ?? new();
            _designations = t2.Result ?? new();
            _perspectives = t3.Result ?? new();

            if (_isEdit)
            {
                var res = await RequisitionSvc.GetByIdAsync(Id!.Value);
                if (res?.Data is not null)
                {
                    var d = res.Data;
                    _form = new RequisitionUpdateDto
                    {
                        RequisitionId = d.RequisitionId,
                        ReqDate = d.ReqDate,
                        DivisionId = d.DivisionId,
                        DepartmentId = d.DepartmentId,
                        DesignationId = d.DesignationId,
                        Vacancy = d.Vacancy,
                        Status = d.Status,
                        Description = d.Description,
                        Details = d.Details.Select(x => new RequisitionDetailUpdateDto
                        {
                            RequisitionDetailId = x.RequisitionDetailId,
                            PerspectiveId = x.PerspectiveId,
                            Objective = x.Objective,
                            KPI = x.KPI,
                            WeightagePercentage = x.WeightagePercentage,
                            Remarks = x.Remarks
                        }).ToList()
                    };

                    if (_form.DivisionId > 0)
                        _departments = await LookupSvc.GetDepartmentsByDivisionAsync((int)_form.DivisionId);
                }
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnDivisionChanged(object value)
    {
        _form.DepartmentId = 0;
        _departments = new();

        if (value is long longId && longId > 0)
            _departments = await LookupSvc.GetDepartmentsByDivisionAsync((int)longId);
        else if (value is int intId && intId > 0)
            _departments = await LookupSvc.GetDepartmentsByDivisionAsync(intId);
        
        StateHasChanged();
    }

    private async Task AddDetailRow()
    {
        _form.Details.Add(new RequisitionDetailUpdateDto());
        if (_grid != null) await _grid.Reload();
    }

    private async Task RemoveDetailRow(RequisitionDetailUpdateDto row)
    {
        _form.Details.Remove(row);
        if (_grid != null) await _grid.Reload();
    }

    private async Task HandleSubmit()
    {
        if (_totalWeight != 100)
        {
            NotificationSvc.Notify(NotificationSeverity.Warning, "Validation", "Total weight must equal 100%.");
            return;
        }

        _saving = true;
        try
        {
            if (_isEdit)
            {
                var res = await RequisitionSvc.UpdateAsync(Id!.Value, _form);
                ProcessResponse(res, "Updated");
            }
            else
            {
                var createDto = new RequisitionCreateDto
                {
                    ReqDate = _form.ReqDate,
                    DivisionId = _form.DivisionId,
                    DepartmentId = _form.DepartmentId,
                    DesignationId = _form.DesignationId,
                    Vacancy = _form.Vacancy,
                    Description = _form.Description,
                    Details = _form.Details.Select(d => new RequisitionDetailCreateDto
                    {
                        PerspectiveId = d.PerspectiveId,
                        Objective = d.Objective,
                        KPI = d.KPI,
                        WeightagePercentage = d.WeightagePercentage,
                        Remarks = d.Remarks
                    }).ToList()
                };

                var res = await RequisitionSvc.CreateAsync(createDto);
                ProcessResponse(res, "Created");
            }
        }
        catch (Exception ex)
        {
            NotificationSvc.Notify(NotificationSeverity.Error, "System Error", ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private void ProcessResponse(dynamic res, string action)
    {
        if (res?.Success == true)
        {
            NotificationSvc.Notify(NotificationSeverity.Success, action, $"Requisition {action.ToLower()} successfully.");
            Nav.NavigateTo("/requisitions");
        }
        else
        {
            NotificationSvc.Notify(NotificationSeverity.Error, "Error", res?.Message ?? "Operation failed.");
        }
    }
}